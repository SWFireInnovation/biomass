    given-names: Greg
    orcid: "https://orcid.org/0000-0002-3427-6932"
    affiliation: "Northern Arizona University"
version: 1.0.0
date-released: 2026-11-05
repository-code: "https://github.com/SWFireInnovation/biomass"
license: MIT
keywords:
  - canopy biomass
  - canopy fuel
  - foliar biomass
  - allometry
  - Southwest Fire Innovation Landscape Network
