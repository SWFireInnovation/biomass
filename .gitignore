# This is a comment
# if it cannot be opened in notepad, it is a binary file
# git can only track size/date of binary files

# avoid committing data paths!!!!
# only commit data_info.template, fill out data_info.yaml every time you work with this.
data_info.yaml

# ignore files by file extension
# ignore all compiled/built from environment
# .. note:: in git style, other users will build there own
*.tdf
*.exe
*.dll
*.pdb
*.dmg
*.pkg
*.app
*.war
*.jar
*.scw

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

#ignore temporary workspace files
*.py[cod]
*.suo
*.t*mp
*.orig
*.asv

# ignore data files
*.dat
*.mat
*.txt
# ignore data file OR dir regardless of case
**[Cc][Ss][Vv]

# ignore images
*.jp*g
*.tif*
*.png
# Large media files
*.mp4
*.avi
*.flv
*.mov
*.wmv

# ignore binary documents
# ignore both legacy and modern Microsoft (e.g. .doc/.docx)
*.pdf
*.doc*
*.xls*
*.ppt*

# ignore archives
*.tar*
*.zip*
*.gz*

# ignore the entire contents of all directories or sub directories
# files named .log or .logs or .logged also excluded
**log*
**doc/*build
**.idea/
**.ipython_checkpoints/
**.ipynb_checkpoints/
**.virtual_documents/
**.vs*/
**[Dd]ebug/
**[Rr]elease/
**[Pp]rov/

# R workspace files
# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
.RDataTmp
# User-specific files
.Ruserdata
# Example code in package build process
*-Ex.R
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
# knitr and R markdown default cache directories
*_cache/
**cache/
# RStudio Connect folder
rsconnect/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
# R Environment Variables
.Renviron

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# translation temp files
po/*~

# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Maven
target/
dist/

# Unit test reports
TEST*.xml